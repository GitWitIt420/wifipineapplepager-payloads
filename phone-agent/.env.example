# Nova Agent — Environment Configuration
# Copy to .env and fill in your values:
#   cp .env.example .env
# Never commit .env to git.

# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# ── ElevenLabs TTS ────────────────────────────────────────────────────────────
# Leave blank to use espeak fallback (free, robotic).
# Get a key at: https://elevenlabs.io
ELEVENLABS_API_KEY=

# Voice ID — Rachel (warm, feminine) is the default.
# Run `nova --list-voices` to browse all available voices.
# Some good feminine options:
#   21m00Tcm4TlvDq8ikWAM  Rachel    — warm, calm, articulate
#   AZnzlk1XvdvUeBnXmlld  Domi      — confident, assertive
#   EXAVITQu4vr4xnSDxMaL  Bella     — soft, intimate
#   MF3mGyEYCl7XYWbV9V6O  Elli      — bright, energetic
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Model — turbo is faster, multilingual is higher quality
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Voice personality knobs (0.0 – 1.0)
VOICE_STABILITY=0.45        # Higher = more consistent, less expressive
VOICE_SIMILARITY=0.85       # How closely to match the original voice
VOICE_STYLE=0.35            # Higher = more dramatic/expressive

# ── Wake word / activation ────────────────────────────────────────────────────
# ptt      → press Enter to talk (good default for terminal use)
# keyword  → always listening, activates on WAKE_WORD
# toggle   → Enter to start, Enter to stop
# always   → no activation, always records
ACTIVATION_MODE=ptt

WAKE_WORD=nova
SLEEP_WORD=sleep nova

# ── Agent identity ────────────────────────────────────────────────────────────
AGENT_NAME=Nova

# ── VPS / remote access ───────────────────────────────────────────────────────
# Your AWS LightSail / VPS for ssh_command tool
VPS_HOST=
VPS_USER=ubuntu
VPS_SSH_KEY=~/.ssh/id_ed25519

# Tailscale IP of VPS (alternative to public IP)
TAILSCALE_IP=

# ── Claude model ──────────────────────────────────────────────────────────────
# claude-sonnet-4-6 (default, fast + smart)
# claude-opus-4-7   (more capable, slower, costs more)
CLAUDE_MODEL=claude-sonnet-4-6
MAX_TOKENS=4096

# ── Audio tuning ──────────────────────────────────────────────────────────────
# Increase SILENCE_THRESHOLD if Nova cuts off your speech too early.
# Decrease it if she waits too long in quiet environments.
SILENCE_THRESHOLD=400
SILENCE_DURATION=1.5
MAX_RECORDING_DURATION=45

# ── Misc ──────────────────────────────────────────────────────────────────────
DEBUG=false
SAFE_MODE=false
MAX_HISTORY_TURNS=30
